rules_version = '2';

// PocketSpend — quy tắc bảo vệ sổ chung.
// Chỉ 2 tài khoản có UID dưới đây được đọc/ghi. Mọi người khác, kể cả ai đó tạo được
// tài khoản trong project của bạn, đều bị từ chối.
// Thay UID_CUA_SANG và UID_CUA_VO bằng UID thật (xem README, phần Bật đồng bộ, Bước 7).

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.uid in ['UID_CUA_SANG', 'UID_CUA_VO'];
    }

    // Mỗi tháng là một document: { budgetCents?: số nguyên, tx?: { id: khoản chi } }
    function validMonth(d) {
      return d.keys().hasOnly(['budgetCents', 'tx'])
        && (!('budgetCents' in d) || (d.budgetCents is int && d.budgetCents > 0 && d.budgetCents <= 99999999999))
        && (!('tx' in d) || (d.tx is map && d.tx.size() <= 3000));
    }

    match /ledgers/family/months/{month} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && validMonth(request.resource.data);
    }

    // Mọi đường dẫn khác: cấm (mặc định)
  }
}
